// Site do PET EEL — modelo de dados
// Conteúdo é editado por blocos (ver src/lib/content/blocos.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon (e qualquer Postgres com pooler): a aplicação usa a URL pooled,
  // as migrações precisam de conexão direta — pooler não roda DDL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Acesso ───────────────────────────
// Login é Google/Gmail sem restrição de domínio. Como qualquer pessoa
// com Gmail consegue autenticar no Google, o controle de acesso NÃO
// pode ser o provedor: é esta tabela. O callback de signIn recusa
// e-mail que não exista aqui.

enum Papel {
  ADMIN  // gerencia pessoas e publica
  EDITOR // edita e salva rascunho
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  nome          String?
  imagem        String?
  emailVerified DateTime?

  papel     Papel   @default(EDITOR)
  ativo     Boolean @default(true) // desliga o acesso sem apagar o histórico
  gestao    String? // "2026.1" — de qual gestão a pessoa é, para a lista do admin

  convidadoPorId String?
  convidadoPor   User?   @relation("Convites", fields: [convidadoPorId], references: [id], onDelete: SetNull)
  convidou       User[]  @relation("Convites")

  primeiroAcesso DateTime?
  criadoEm       DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  revisoes PaginaRevisao[]
  midias   Midia[]
  documentos Documento[]

  @@index([ativo])
}

// Tabelas exigidas pelo adapter do Auth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────── Conteúdo ───────────────────────────

enum StatusPagina {
  RASCUNHO
  PUBLICADA
}

model Pagina {
  id        String       @id @default(cuid())
  slug      String       @unique // "/projetos-internos"
  titulo    String
  descricao String? // usado na tag <meta description>
  status    StatusPagina @default(RASCUNHO)

  // Lista ordenada de blocos, validada por Zod na borda (blocosSchema).
  // JSONB em vez de tabela-por-bloco: cada tipo de bloco tem props
  // diferentes, o salvamento é atômico e reordenar é reordenar o array.
  blocos   Json  @default("[]") // o que está no ar
  rascunho Json? // edição em andamento; publicar copia para `blocos`

  // Hierarquia do menu — "Projetos internos" é filho de "Pesquisa"
  paiId  String?
  pai    Pagina?  @relation("Hierarquia", fields: [paiId], references: [id], onDelete: SetNull)
  filhos Pagina[] @relation("Hierarquia")
  ordem  Int      @default(0)
  noMenu Boolean  @default(true)

  // Página fixa não pode ser apagada pela interface (home, mapa do site)
  fixa Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  revisoes PaginaRevisao[]

  @@index([status])
  @@index([paiId, ordem])
}

// Histórico. O grupo troca de gestão todo ano; alguém vai apagar um
// bloco sem querer e precisar voltar.
model PaginaRevisao {
  id       String @id @default(cuid())
  paginaId String
  pagina   Pagina @relation(fields: [paginaId], references: [id], onDelete: Cascade)

  blocos   Json
  resumo   String? // "publicou", "restaurou revisão de 12/03"
  autorId  String?
  autor    User?    @relation(fields: [autorId], references: [id], onDelete: SetNull)
  criadoEm DateTime @default(now())

  @@index([paginaId, criadoEm])
}

model Midia {
  id       String @id @default(cuid())
  chave    String @unique // caminho no storage (Blob/S3)
  url      String
  largura  Int
  altura   Int
  tamanho  Int // bytes
  mimeType String

  // Obrigatório na interface de upload: sem alt o site não é acessível
  // e o PET é um programa de ensino público.
  alt String

  enviadoPorId String?
  enviadoPor   User?   @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  petianos Petiano[]

  @@index([criadoEm])
}

// Currículo em PDF, vinculado a um Petiano. Modelo separado de Midia
// porque documento não tem largura/altura — forçar isso pra PDF seria
// artificial.
model Documento {
  id      String @id @default(cuid())
  chave   String @unique // caminho no storage (Blob/local)
  url     String
  nome    String // nome original do arquivo, exibido/baixado com esse nome
  tamanho Int // bytes

  enviadoPorId String?
  enviadoPor   User?   @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  petianos Petiano[]

  @@index([criadoEm])
}

// Aparece em toda página (rodapé, contato, redes). Linha única.
model Config {
  id Int @id @default(1)

  nomeSite  String @default("PET EEL")
  descricao String @default("Programa de Educação Tutorial de Engenharia Elétrica — UFSC")

  endereco String?
  telefone String?
  email    String?

  instagram String?
  linkedin  String?
  facebook  String?
  spotify   String?

  // Faixa de aviso no topo ("Sexta, 12h10 — seminário semanal")
  avisoTexto  String?
  avisoLink   String?
  avisoAtivo  Boolean @default(false)

  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────── Pessoas ───────────────────────────
// O bloco `equipe` puxa daqui, não de conteúdo digitado — senão toda
// gestão redigita os 12 membros. A mesma tabela serve a página de
// Ex-PETianos: quem saiu tem `saiuEm` preenchido.

model Petiano {
  id     String  @id @default(cuid())
  nome   String
  cargo  String  // "Coord. de Pesquisa", "Docente EEL"
  tutor  Boolean @default(false)
  bio    String?

  fotoId String?
  foto   Midia?  @relation(fields: [fotoId], references: [id], onDelete: SetNull)

  curriculoId String?
  curriculo   Documento? @relation(fields: [curriculoId], references: [id], onDelete: SetNull)

  entrouEm DateTime
  saiuEm   DateTime? // preenchido = ex-petiano
  destino  String? // "Mestrado UFSC", "Engenheira na WEG" — só para egressos

  lattes    String?
  linkedin  String?

  ordem    Int      @default(0)
  criadoEm DateTime @default(now())

  @@index([saiuEm, ordem])
}
