DATABASE_URL="postgresql://usuario:senha@host:5432/peteel"
DIRECT_URL=            # conexão direta (sem pooler), usada pelas migrações

AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=         # console.cloud.google.com → OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL="http://localhost:3000"

ADMIN_INICIAL=          # e-mail do primeiro admin, criado pelo seed

STORAGE="local"         # "local" em dev, "blob" em produção
BLOB_READ_WRITE_TOKEN=

# Igual a STORAGE, mas exposta ao navegador (prefixo NEXT_PUBLIC_) — é o
# que decide, no upload de foto/currículo, se o arquivo vai direto pro
# Blob (evita o teto de 4,5 MB de Server Action da Vercel) ou pela
# Server Action antiga (só funciona sem esse teto fora da Vercel).
NEXT_PUBLIC_STORAGE="local"
